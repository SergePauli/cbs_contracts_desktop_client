<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows10.0.19041.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.17763.0</TargetPlatformMinVersion>
    <RootNamespace>CbsContractsDesktopClient</RootNamespace>
    <AssemblyName>CbsContractsDesktopClient</AssemblyName>
    <UseWinUI>true</UseWinUI>
    <WindowsPackageType>None</WindowsPackageType>
    <SelfContained>false</SelfContained>
    <WindowsAppSDKSelfContained>false</WindowsAppSDKSelfContained>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets\favicon.ico</ApplicationIcon>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>preview</LangVersion>
    <Platforms>x86;x64;ARM64</Platforms>
    <SatelliteResourceLanguages>ru-RU;en-US</SatelliteResourceLanguages>
  </PropertyGroup>

  <Target Name="FilterWinUiMuiLanguages" AfterTargets="_UpdateMuiFilesAfterNugetRestore">
    <ItemGroup>
      <_UnsupportedWinUiMui Include="@(RuntimeTargetsCopyLocalItems)"
                            Condition="'%(RuntimeTargetsCopyLocalItems.Extension)' == '.mui'
                              and !$([System.String]::Copy('%(RuntimeTargetsCopyLocalItems.DestinationSubDirectory)').ToLowerInvariant().StartsWith('ru-ru\'))
                              and !$([System.String]::Copy('%(RuntimeTargetsCopyLocalItems.DestinationSubDirectory)').ToLowerInvariant().StartsWith('en-us\'))" />
      <RuntimeTargetsCopyLocalItems Remove="@(_UnsupportedWinUiMui)" />
    </ItemGroup>
  </Target>

  <Target Name="ValidateFrameworkDependentPublish" BeforeTargets="Publish">
    <Error Condition="'$(SelfContained)' == 'true' or '$(WindowsAppSDKSelfContained)' == 'true'"
           Text="ContractsDesktopClient must be published as framework-dependent." />
  </Target>

  <ItemGroup>
    <Compile Remove="tests\**\*.cs" />
    <Compile Remove="tempobj\**\*.cs" />
    <Compile Remove="tmpbuild_*\**\*.cs" />
    <Compile Remove="tmpverify\**\*.cs" />
    <Compile Remove="obj_verify*\**\*.cs" />
    <Compile Remove="src\Pauli.WinUiKit\**\*.cs" />
    <EmbeddedResource Remove="tests\**\*" />
    <EmbeddedResource Remove="tempobj\**\*" />
    <EmbeddedResource Remove="tmpbuild_*\**\*" />
    <EmbeddedResource Remove="tmpverify\**\*" />
    <EmbeddedResource Remove="obj_verify*\**\*" />
    <EmbeddedResource Remove="src\Pauli.WinUiKit\**\*" />
    <None Remove="tests\**\*" />
    <None Remove="tempobj\**\*" />
    <None Remove="tmpbuild_*\**\*" />
    <None Remove="tmpverify\**\*" />
    <None Remove="obj_verify*\**\*" />
    <None Remove="src\Pauli.WinUiKit\**\*" />
    <Page Remove="tests\**\*" />
    <Page Remove="tempobj\**\*" />
    <Page Remove="tmpbuild_*\**\*" />
    <Page Remove="tmpverify\**\*" />
    <Page Remove="obj_verify*\**\*" />
    <Page Remove="src\Pauli.WinUiKit\**\*" />
    <Content Remove="tests\**\*" />
    <Content Remove="tempobj\**\*" />
    <Content Remove="tmpbuild_*\**\*" />
    <Content Remove="tmpverify\**\*" />
    <Content Remove="obj_verify*\**\*" />
    <Content Remove="src\Pauli.WinUiKit\**\*" />
    <PRIResource Remove="tests\**\*" />
    <PRIResource Remove="tempobj\**\*" />
    <PRIResource Remove="tmpbuild_*\**\*" />
    <PRIResource Remove="tmpverify\**\*" />
    <PRIResource Remove="obj_verify*\**\*" />
    <PRIResource Remove="src\Pauli.WinUiKit\**\*" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="Assets\favicon.ico">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="Assets\login-logo-clean.png">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.WindowsAppSDK" Version="1.8.260317003" />
    <PackageReference Include="Microsoft.WindowsAppSDK.AI" Version="1.8.53" ExcludeAssets="all" />
    <PackageReference Include="Microsoft.WindowsAppSDK.ML" Version="1.8.2141" ExcludeAssets="all" />
    <PackageReference Include="Microsoft.WindowsAppSDK.Widgets" Version="1.8.251231004" ExcludeAssets="all" />
    <PackageReference Include="System.Numerics.Tensors" Version="9.0.0" ExcludeAssets="all" />
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="10.0.5" />
    <PackageReference Include="Microsoft.Extensions.Http" Version="10.0.5" />
    <PackageReference Include="WinUI.TableView" Version="1.4.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="src\Pauli.WinUiKit\Pauli.WinUiKit.csproj" />
  </ItemGroup>
</Project>
