<dialogs:AppEditDialog
    x:Class="CbsContractsDesktopClient.Views.References.EmployeeEditDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:dialogs="using:CbsContractsDesktopClient.Shared.Dialogs"
    xmlns:local="using:CbsContractsDesktopClient.Views.References"
    Title="{Binding DialogTitle}" FullSizeDesired="False" HorizontalAlignment="Center">
    <dialogs:AppEditDialog.Resources>
        <x:Double x:Key="ContentDialogMinWidth">500</x:Double>
        <x:Double x:Key="ContentDialogMaxWidth">800</x:Double>
        <Style TargetType="TextBox">
            <Setter Property="FontSize" Value="14" />
            <Setter Property="FontWeight" Value="Normal" />
            <Setter Property="MinHeight" Value="30" />
            <Setter Property="Padding" Value="8,5" />
        </Style>
        <Style TargetType="AutoSuggestBox">
            <Setter Property="FontSize" Value="14" />
            <Setter Property="FontWeight" Value="Normal" />
            <Setter Property="MinHeight" Value="30" />
            <Setter Property="Padding" Value="8,5" />
            <Setter Property="UpdateTextOnSelect" Value="False" />
            <Setter Property="MaxSuggestionListHeight" Value="180" />
        </Style>
        <Style x:Key="LabelStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontWeight" Value="Normal" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <DataTemplate x:Key="SuggestionTemplate">
            <TextBlock Text="{Binding}" Height="24" TextTrimming="CharacterEllipsis" />
        </DataTemplate>
    </dialogs:AppEditDialog.Resources>
    <Grid RowSpacing="8" Width="602">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <ScrollViewer MaxHeight="560" VerticalScrollBarVisibility="Auto">
            <StackPanel Spacing="8">
                <InfoBar Severity="Error" IsClosable="True"
                         Message="{Binding ErrorInfoMessage}"
                         IsOpen="{Binding IsErrorInfoVisible, Mode=TwoWay}" />
                <Grid x:Name="IdRow" ColumnSpacing="12">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="90" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                    <TextBlock Text="ID" Style="{StaticResource LabelStyle}" />
                    <TextBox Grid.Column="1" Text="{Binding Id}" IsReadOnly="True" IsTabStop="False" Width="180" HorizontalAlignment="Left" />
                </Grid>
                <Grid ColumnSpacing="12" RowSpacing="8">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="90" /><ColumnDefinition Width="500" /></Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <TextBlock Text="ФИО *" Style="{StaticResource LabelStyle}" />
                    <TextBox Grid.Column="1" Text="{Binding PersonName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                    <TextBlock Grid.Row="1" Text="Должность *" Style="{StaticResource LabelStyle}" />
                    <AutoSuggestBox x:Name="PositionEditor" Grid.Row="1" Grid.Column="1"
                        Text="{Binding PositionInput, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                        ItemsSource="{Binding PositionSuggestionLabels}" ItemTemplate="{StaticResource SuggestionTemplate}"
                        TextChanged="Position_TextChanged" SuggestionChosen="Position_SuggestionChosen"
                        QuerySubmitted="Position_QuerySubmitted" LostFocus="Position_LostFocus" />
                    <TextBlock Grid.Row="2" Text="Контрагент *" Style="{StaticResource LabelStyle}" />
                    <AutoSuggestBox x:Name="ContragentEditor" Grid.Row="2" Grid.Column="1"
                        Text="{Binding ContragentInput, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                        ItemsSource="{Binding ContragentSuggestionLabels}" ItemTemplate="{StaticResource SuggestionTemplate}"
                        MaxSuggestionListHeight="240" TextChanged="Contragent_TextChanged"
                        SuggestionChosen="Contragent_SuggestionChosen" QuerySubmitted="Contragent_QuerySubmitted"
                        LostFocus="Contragent_LostFocus" />
                    <TextBlock Grid.Row="3" Text="Контакты *" Style="{StaticResource LabelStyle}" />
                    <local:DialogContactsEditor Grid.Row="3" Grid.Column="1" ContactsText="{Binding ContactsText, Mode=TwoWay}" />
                    <TextBlock Grid.Row="4" Text="Актуален" Style="{StaticResource LabelStyle}" />
                    <CheckBox Grid.Row="4" Grid.Column="1" IsChecked="{Binding IsUsed, Mode=TwoWay}" MinHeight="28" />
                    <TextBlock Grid.Row="5" Text="Пор." Style="{StaticResource LabelStyle}" />
                    <TextBox Grid.Row="5" Grid.Column="1" Width="80" HorizontalAlignment="Left" Text="{Binding PriorityText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                    <TextBlock Grid.Row="6" Text="Описание" Style="{StaticResource LabelStyle}" />
                    <TextBox Grid.Row="6" Grid.Column="1" MinHeight="76" AcceptsReturn="True" TextWrapping="Wrap" Text="{Binding Description, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                </Grid>
            </StackPanel>
        </ScrollViewer>
        <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right" Spacing="4">
            <Button x:Name="SaveButton" Content="Сохранить" Width="112" MinHeight="28" Padding="8,2" />
            <Button x:Name="CancelButton" Content="Отмена" Width="112" MinHeight="28" Padding="8,2" />
        </StackPanel>
    </Grid>
</dialogs:AppEditDialog>