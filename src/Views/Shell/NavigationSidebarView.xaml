<UserControl
    x:Class="CbsContractsDesktopClient.Views.Shell.NavigationSidebarView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Border
        Margin="{StaticResource ShellSidebarOuterPadding}"
        BorderBrush="{StaticResource ShellSidebarBorderBrush}"
        BorderThickness="1"
        CornerRadius="6">
        <Border.Background>
            <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                <GradientStop Offset="0" Color="{Binding Color, Source={StaticResource ShellSidebarGradientStartBrush}}" />
                <GradientStop Offset="1" Color="{Binding Color, Source={StaticResource ShellSidebarGradientEndBrush}}" />
            </LinearGradientBrush>
        </Border.Background>

        <NavigationView
            x:Name="SidebarNavigationView"
            Padding="0"
            Background="Transparent"
            PaneDisplayMode="Left"
            IsPaneOpen="True"
            IsPaneToggleButtonVisible="False"
            IsBackButtonVisible="Collapsed"
            IsSettingsVisible="False"
            AlwaysShowHeader="False"
            CompactModeThresholdWidth="0"
            ExpandedModeThresholdWidth="0"
            PaneTitle=""
            ItemInvoked="SidebarNavigationView_ItemInvoked"
            SelectionChanged="SidebarNavigationView_SelectionChanged">
            <NavigationView.Resources>
                <x:Double x:Key="NavigationViewItemOnLeftMinHeight">20</x:Double>
                <Thickness x:Key="NavigationViewItemButtonMargin">0</Thickness>
                <Thickness x:Key="NavigationViewItemInnerHeaderMargin">8,0</Thickness>

                <Style TargetType="NavigationViewItem">
                    <Setter Property="MinHeight" Value="{StaticResource ShellMenuItemMinHeight}" />
                    <Setter Property="Padding" Value="0" />
                    <Setter Property="Margin" Value="0" />
                    <Setter Property="FontSize" Value="14" />
                </Style>

                <Style TargetType="NavigationViewItemHeader">
                    <Setter Property="Margin" Value="8,8,6,1" />
                    <Setter Property="Padding" Value="0" />
                    <Setter Property="FontSize" Value="10" />
                    <Setter Property="FontWeight" Value="SemiBold" />
                    <Setter Property="Foreground" Value="{StaticResource ShellTertiaryTextBrush}" />
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="NavigationViewItemHeader">
                                <Border
                                    Margin="{TemplateBinding Margin}"
                                    Padding="{TemplateBinding Padding}">
                                    <TextBlock
                                        VerticalAlignment="Center"
                                        FontSize="{TemplateBinding FontSize}"
                                        FontWeight="{TemplateBinding FontWeight}"
                                        Foreground="{TemplateBinding Foreground}"
                                        Text="{TemplateBinding Content}"
                                        TextTrimming="CharacterEllipsis"
                                        TextWrapping="NoWrap" />
                                </Border>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Style>
            </NavigationView.Resources>
        </NavigationView>
    </Border>
</UserControl>
