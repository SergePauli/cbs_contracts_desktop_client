<UserControl
    x:Class="CbsContractsDesktopClient.Views.Shell.DiagnosticsHostView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Grid Padding="0">
        <Border
            Margin="0"
            Background="{StaticResource ShellPanelBackgroundBrush}"
            BorderBrush="{StaticResource ShellPanelBorderBrush}"
            BorderThickness="1"
            CornerRadius="6">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <Grid
                    Padding="8,4"
                    Background="{StaticResource ShellPanelBackgroundBrush}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel
                        Orientation="Horizontal"
                        Spacing="10"
                        VerticalAlignment="Center">
                        <TextBlock
                            VerticalAlignment="Center"
                            Style="{StaticResource BodyStrongTextBlockStyle}"
                            Foreground="{StaticResource ShellPrimaryTextBrush}"
                            Text="Диагностика" />
                        <TextBlock
                            x:Name="LastCheckedTextBlock"
                            VerticalAlignment="Center"
                            Foreground="{StaticResource ShellSecondaryTextBrush}"
                            Text="Проверка не выполнялась" />
                    </StackPanel>

                    <StackPanel
                        Grid.Column="1"
                        Orientation="Horizontal"
                        Spacing="6"
                        VerticalAlignment="Center">
                        <ProgressRing
                            x:Name="LoadingRing"
                            Width="16"
                            Height="16"
                            IsActive="False" />
                        <Button
                            x:Name="RefreshButton"
                            Width="{StaticResource ShellActionButtonSize}"
                            Height="{StaticResource ShellActionButtonSize}"
                            Padding="0"
                            Background="Transparent"
                            BorderBrush="{x:Null}"
                            Click="RefreshButton_Click"
                            Content="&#xE72C;"
                            FontFamily="Segoe Fluent Icons"
                            FontSize="14"
                            Foreground="{StaticResource ShellSecondaryTextBrush}"
                            ToolTipService.ToolTip="Обновить диагностику" />
                    </StackPanel>
                </Grid>

                <ScrollViewer
                    Grid.Row="1"
                    Padding="8"
                    Background="{StaticResource ShellMutedPanelBackgroundBrush}">
                    <ItemsControl x:Name="ChecksItemsControl">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid
                                    Margin="0,0,0,6"
                                    Padding="8,6"
                                    Background="{StaticResource ShellPanelBackgroundBrush}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="220" />
                                        <ColumnDefinition Width="130" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>

                                    <TextBlock
                                        VerticalAlignment="Center"
                                        Foreground="{StaticResource ShellPrimaryTextBrush}"
                                        Text="{Binding Title}"
                                        TextTrimming="CharacterEllipsis" />

                                    <StackPanel
                                        Grid.Column="1"
                                        Orientation="Horizontal"
                                        Spacing="6"
                                        VerticalAlignment="Center">
                                        <FontIcon
                                            FontFamily="Segoe Fluent Icons"
                                            FontSize="10"
                                            Foreground="{Binding StatusBrush}"
                                            Glyph="&#xEA3A;" />
                                        <TextBlock
                                            VerticalAlignment="Center"
                                            FontWeight="SemiBold"
                                            Foreground="{Binding StatusBrush}"
                                            Text="{Binding StatusText}"
                                            TextTrimming="CharacterEllipsis" />
                                    </StackPanel>

                                    <StackPanel
                                        Grid.Column="2"
                                        Orientation="Horizontal"
                                        Spacing="6"
                                        VerticalAlignment="Center">
                                        <TextBlock
                                            Foreground="{StaticResource ShellSecondaryTextBrush}"
                                            Text="{Binding Target}"
                                            TextTrimming="CharacterEllipsis" />
                                        <TextBlock
                                            Foreground="{StaticResource ShellPrimaryTextBrush}"
                                            FontWeight="SemiBold"
                                            Text="{Binding Detail}"
                                            TextTrimming="CharacterEllipsis" />
                                    </StackPanel>
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </Grid>
        </Border>
    </Grid>
</UserControl>
