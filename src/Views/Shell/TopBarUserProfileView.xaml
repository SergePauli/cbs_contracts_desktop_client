<UserControl
    x:Class="CbsContractsDesktopClient.Views.Shell.TopBarUserProfileView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Button
        MinWidth="0"
        Height="26"
        Padding="8,0,8,0"
        HorizontalAlignment="Right"
        VerticalAlignment="Center"
        Background="Transparent"
        BorderBrush="{StaticResource ShellPanelBorderBrush}"
        BorderThickness="1"
        CornerRadius="6"
        ToolTipService.ToolTip="{x:Bind ProfileToolTip, Mode=OneWay}">
        <StackPanel
            Orientation="Horizontal"
            Spacing="5"
            VerticalAlignment="Center">
            <FontIcon
                Glyph="&#xE77B;"
                FontFamily="{StaticResource SymbolThemeFontFamily}"
                FontSize="11"
                Foreground="{StaticResource ShellAccentBrush}" />
            <TextBlock
                MaxWidth="190"
                Style="{StaticResource CaptionTextBlockStyle}"
                Foreground="{StaticResource ShellPrimaryTextBrush}"
                Text="{x:Bind DepartmentLabel, Mode=OneWay}"
                TextTrimming="CharacterEllipsis"
                TextWrapping="NoWrap" />
        </StackPanel>

        <Button.Flyout>
            <Flyout Placement="BottomEdgeAlignedRight">
                <Border
                    Width="280"
                    Padding="10,8,10,10"
                    Background="{StaticResource ShellPanelBackgroundBrush}">
                    <Grid RowSpacing="7" ColumnSpacing="10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="58" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <TextBlock
                            Grid.Row="0"
                            Grid.Column="0"
                            Style="{StaticResource CaptionTextBlockStyle}"
                            Foreground="{StaticResource ShellTertiaryTextBrush}"
                            Text="Логин" />
                        <TextBlock
                            Grid.Row="0"
                            Grid.Column="1"
                            Style="{StaticResource BodyStrongTextBlockStyle}"
                            Foreground="{StaticResource ShellAccentBrush}"
                            Text="{x:Bind UsernameText, Mode=OneWay}"
                            TextTrimming="CharacterEllipsis"
                            TextWrapping="NoWrap" />

                        <TextBlock
                            Grid.Row="1"
                            Grid.Column="0"
                            Style="{StaticResource CaptionTextBlockStyle}"
                            Foreground="{StaticResource ShellTertiaryTextBrush}"
                            Text="ФИО" />
                        <TextBlock
                            Grid.Row="1"
                            Grid.Column="1"
                            Style="{StaticResource BodyStrongTextBlockStyle}"
                            Foreground="{StaticResource ShellPrimaryTextBrush}"
                            Text="{x:Bind FullNameText, Mode=OneWay}"
                            TextTrimming="CharacterEllipsis"
                            TextWrapping="NoWrap" />

                        <TextBlock
                            Grid.Row="2"
                            Grid.Column="0"
                            Style="{StaticResource CaptionTextBlockStyle}"
                            Foreground="{StaticResource ShellTertiaryTextBrush}"
                            Text="Почта" />
                        <TextBlock
                            Grid.Row="2"
                            Grid.Column="1"
                            Style="{StaticResource BodyStrongTextBlockStyle}"
                            Foreground="{StaticResource ShellAccentBrush}"
                            Text="{x:Bind EmailText, Mode=OneWay}"
                            TextTrimming="CharacterEllipsis"
                            TextWrapping="NoWrap" />

                        <TextBlock
                            Grid.Row="3"
                            Grid.Column="0"
                            Style="{StaticResource CaptionTextBlockStyle}"
                            Foreground="{StaticResource ShellTertiaryTextBrush}"
                            Text="Роли" />
                        <TextBlock
                            Grid.Row="3"
                            Grid.Column="1"
                            Style="{StaticResource BodyStrongTextBlockStyle}"
                            Foreground="{StaticResource ShellPrimaryTextBrush}"
                            Text="{x:Bind RolesText, Mode=OneWay}"
                            TextTrimming="CharacterEllipsis"
                            TextWrapping="NoWrap" />
                    </Grid>
                </Border>
            </Flyout>
        </Button.Flyout>
    </Button>
</UserControl>
