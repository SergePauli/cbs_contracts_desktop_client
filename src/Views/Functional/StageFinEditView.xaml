<UserControl
    x:Class="CbsContractsDesktopClient.Views.Functional.StageFinEditView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Grid
        MinWidth="650"
        MaxWidth="720"
        RowSpacing="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Spacing="12">
            <ContentControl
                x:Name="ContractTitleHost"
                HorizontalAlignment="Center" />

            <Grid ColumnSpacing="42" RowSpacing="6">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <StackPanel Spacing="6">
                    <Grid ColumnSpacing="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="135" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Контрагент" Foreground="{StaticResource ShellSecondaryTextBrush}" />
                        <TextBlock x:Name="ContragentText" Grid.Column="1" FontWeight="SemiBold" TextWrapping="Wrap" />
                    </Grid>
                    <Grid ColumnSpacing="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="135" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Стоимость" Foreground="{StaticResource ShellSecondaryTextBrush}" />
                        <TextBlock
                            x:Name="ContractCostText"
                            Grid.Column="1"
                            FontWeight="SemiBold"
                            Foreground="{StaticResource ShellAccentBrush}"
                            TextWrapping="Wrap" />
                    </Grid>
                </StackPanel>

                <StackPanel Grid.Column="1" Spacing="6">
                    <Grid ColumnSpacing="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="135" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Статус" Foreground="{StaticResource ShellSecondaryTextBrush}" />
                        <ContentControl
                            x:Name="ContractStatusHost"
                            Grid.Column="1"
                            HorizontalAlignment="Left" />
                    </Grid>
                    <Grid ColumnSpacing="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="135" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Дата подписания" Foreground="{StaticResource ShellSecondaryTextBrush}" />
                        <TextBlock x:Name="SignedAtText" Grid.Column="1" FontWeight="SemiBold" TextWrapping="Wrap" />
                    </Grid>
                </StackPanel>
            </Grid>

            <Grid HorizontalAlignment="Stretch" ColumnSpacing="6">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Button
                    x:Name="PreviousStageButton"
                    Grid.Column="1"
                    Width="24"
                    Height="24"
                    MinWidth="0"
                    MinHeight="0"
                    Padding="0"
                    BorderThickness="0"
                    CornerRadius="5"
                    FontFamily="{StaticResource SymbolThemeFontFamily}"
                    FontSize="12"
                    Content="&#xE76B;" />
                <TextBlock
                    x:Name="StageTitleText"
                    Grid.Column="2"
                    VerticalAlignment="Center"
                    FontSize="14"
                    LineHeight="18"
                    FontWeight="SemiBold"
                    Foreground="{StaticResource ShellPrimaryTextBrush}"
                    TextAlignment="Center"
                    TextTrimming="CharacterEllipsis"
                    TextWrapping="NoWrap" />
                <Button
                    x:Name="NextStageButton"
                    Grid.Column="3"
                    Width="24"
                    Height="24"
                    MinWidth="0"
                    MinHeight="0"
                    Padding="0"
                    BorderThickness="0"
                    CornerRadius="5"
                    FontFamily="{StaticResource SymbolThemeFontFamily}"
                    FontSize="12"
                    Content="&#xE76C;" />
            </Grid>

            <Grid ColumnSpacing="42" RowSpacing="6">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <StackPanel Spacing="6">
                    <Grid ColumnSpacing="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="135" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Статус" Foreground="{StaticResource ShellSecondaryTextBrush}" />
                        <ContentControl
                            x:Name="StageStatusHost"
                            Grid.Column="1"
                            HorizontalAlignment="Left" />
                    </Grid>
                    <Grid ColumnSpacing="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="135" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Дата начала" Foreground="{StaticResource ShellSecondaryTextBrush}" />
                        <TextBlock x:Name="StartAtText" Grid.Column="1" FontWeight="SemiBold" TextWrapping="Wrap" />
                    </Grid>
                    <Grid ColumnSpacing="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="135" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Режим оплаты" Foreground="{StaticResource ShellSecondaryTextBrush}" />
                        <TextBlock x:Name="PaymentKindText" Grid.Column="1" FontWeight="SemiBold" TextWrapping="Wrap" />
                    </Grid>
                    <Grid ColumnSpacing="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="135" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Срок оплаты" Foreground="{StaticResource ShellSecondaryTextBrush}" />
                        <TextBlock x:Name="PaymentDeadlineAtText" Grid.Column="1" FontWeight="SemiBold" TextWrapping="Wrap" />
                    </Grid>
                </StackPanel>

                <StackPanel Grid.Column="1" Spacing="6">
                    <Grid ColumnSpacing="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="135" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Срок завершения" Foreground="{StaticResource ShellSecondaryTextBrush}" />
                        <TextBlock x:Name="DeadlineAtText" Grid.Column="1" FontWeight="SemiBold" TextWrapping="Wrap" />
                    </Grid>
                    <Grid ColumnSpacing="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="135" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Дата завершения" Foreground="{StaticResource ShellSecondaryTextBrush}" />
                        <TextBlock x:Name="CompletedAtText" Grid.Column="1" FontWeight="SemiBold" TextWrapping="Wrap" />
                    </Grid>
                    <Grid ColumnSpacing="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="135" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Выезд" Foreground="{StaticResource ShellSecondaryTextBrush}" />
                        <TextBlock x:Name="RideOutText" Grid.Column="1" FontWeight="SemiBold" TextWrapping="Wrap" />
                    </Grid>
                    <Grid ColumnSpacing="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="135" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Отправка" Foreground="{StaticResource ShellSecondaryTextBrush}" />
                        <TextBlock x:Name="SendedText" Grid.Column="1" FontWeight="SemiBold" TextWrapping="Wrap" />
                    </Grid>
                </StackPanel>
            </Grid>
        </StackPanel>

        <Border
            Grid.Row="1"
            BorderBrush="{StaticResource ShellTableGridLineBrush}"
            BorderThickness="0,1,0,0" />

        <Border
            Grid.Row="2"
            Padding="8,6,8,8"
            Background="#EFFFF2">
            <Grid RowSpacing="12">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <Grid ColumnSpacing="14">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="116" />
                        <ColumnDefinition Width="116" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Spacing="4">
                        <TextBlock FontSize="12" Text="Внешний номер" />
                        <ContentControl
                            x:Name="ExternalNumberHost"
                            HorizontalContentAlignment="Stretch" />
                    </StackPanel>
                    <StackPanel Grid.Column="1" Spacing="4">
                        <TextBlock FontSize="12" Text="Счет" />
                        <ContentControl
                            x:Name="InvoiceAtHost"
                            HorizontalAlignment="Left"
                            HorizontalContentAlignment="Left"
                            VerticalAlignment="Center" />
                    </StackPanel>
                    <StackPanel Grid.Column="2" Spacing="4">
                        <TextBlock FontSize="12" Text="Оплата" />
                        <ContentControl
                            x:Name="PaymentAtHost"
                            HorizontalAlignment="Left"
                            HorizontalContentAlignment="Left"
                            VerticalAlignment="Center" />
                    </StackPanel>
                </Grid>

                <Grid Grid.Row="1" ColumnSpacing="14">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="116" />
                        <ColumnDefinition Width="116" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Spacing="4">
                        <TextBlock FontSize="12" Text="Предоплата" />
                        <ContentControl
                            x:Name="PrepaymentAtHost"
                            HorizontalAlignment="Left"
                            HorizontalContentAlignment="Left"
                            VerticalAlignment="Center" />
                    </StackPanel>
                    <StackPanel Grid.Column="1" Spacing="4">
                        <TextBlock FontSize="12" Text="Бух.закрытие" />
                        <ContentControl
                            x:Name="FundedAtHost"
                            HorizontalAlignment="Left"
                            HorizontalContentAlignment="Left"
                            VerticalAlignment="Center" />
                    </StackPanel>
                    <StackPanel Grid.Column="2" Spacing="4">
                        <TextBlock FontSize="12" Text="Комментарий" />
                        <ContentControl
                            x:Name="CommentHost"
                            HorizontalContentAlignment="Stretch" />
                    </StackPanel>
                </Grid>
            </Grid>
        </Border>

        <ContentControl
            x:Name="CommentListHost"
            Grid.Row="3"
            HorizontalContentAlignment="Stretch" />
    </Grid>
</UserControl>
