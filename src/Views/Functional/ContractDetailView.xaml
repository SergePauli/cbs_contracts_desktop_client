<UserControl
    x:Class="CbsContractsDesktopClient.Views.Functional.ContractDetailView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="using:CbsContractsDesktopClient.Views.Functional"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:references="using:CbsContractsDesktopClient.Views.References"
    mc:Ignorable="d">

    <Border
        Height="342"
        Style="{StaticResource ShellDetailFooterRootBorderStyle}">
        <Grid
            Padding="4,2,4,2"
            ColumnSpacing="4">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="70*" />
                <ColumnDefinition Width="30*" />
            </Grid.ColumnDefinitions>

            <Grid
                Grid.Column="0"
                RowSpacing="1"
                Padding="1">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <StackPanel
                    Orientation="Horizontal"
                    Spacing="4"
                    VerticalAlignment="Center"
                    Padding="0">
                    <TextBlock
                        x:Name="ContractNameTextBlock"
                        Style="{StaticResource BodyStrongTextBlockStyle}"
                        Foreground="{StaticResource ShellPrimaryTextBrush}"
                        TextTrimming="CharacterEllipsis"
                        FontSize="13"
                        TextWrapping="NoWrap" 
                        Padding="2"/>
                    <TextBlock
                        x:Name="ContragentNameTextBlock"
                        Style="{StaticResource BodyTextBlockStyle}"
                        Foreground="{StaticResource ShellSecondaryTextBrush}"
                        FontStyle="Italic"
                        FontSize="13"
                        TextTrimming="CharacterEllipsis"
                        TextWrapping="NoWrap" 
                        Padding="2"/>
                    <Grid
                        x:Name="ContactsPanel"
                        VerticalAlignment="Center"
                        ColumnSpacing="0"
                        RowSpacing="0" />
                </StackPanel>

                <Border
                    Grid.Row="1"
                    MinHeight="138"
                    Padding="2,1,0,6"
                    Background="{StaticResource ShellPanelBackgroundBrush}"
                    BorderBrush="{StaticResource ShellPanelBorderBrush}"
                    BorderThickness="1"
                    CornerRadius="6">
                    <Grid RowSpacing="2">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <TextBlock
                            Style="{StaticResource CaptionTextBlockStyle}"
                            FontSize="10"
                            FontWeight="Normal"
                            Margin="6,0,0,0"
                            Foreground="{StaticResource ShellTertiaryTextBrush}"
                            Text="Комментарии" />

                        <local:CommentBox
                            x:Name="CommentsBox"
                            Grid.Row="1"
                            VerticalAlignment="Stretch" />
                    </Grid>
                </Border>
            </Grid>

            <Border
                Grid.Column="1"
                Style="{StaticResource ShellDetailFooterColumnSeparatorStyle}">
                <references:EmployeeBox x:Name="EmployeesBox" />
            </Border>
        </Grid>
    </Border>
</UserControl>
