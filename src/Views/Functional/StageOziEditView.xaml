<UserControl
    x:Class="CbsContractsDesktopClient.Views.Functional.StageOziEditView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Grid
        MinWidth="700"
        MaxWidth="820"
        RowSpacing="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Spacing="12">
            <ContentControl
                x:Name="ContractTitleHost"
                HorizontalAlignment="Center" />

            <Grid ColumnSpacing="42" RowSpacing="6">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <StackPanel Spacing="6">
                    <Grid ColumnSpacing="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="135" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Внешний номер" Foreground="{StaticResource ShellSecondaryTextBrush}" />
                        <TextBlock x:Name="ExternalNumberText" Grid.Column="1" FontWeight="SemiBold" TextWrapping="Wrap" />
                    </Grid>
                    <Grid ColumnSpacing="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="135" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Контрагент" Foreground="{StaticResource ShellSecondaryTextBrush}" />
                        <TextBlock x:Name="ContragentText" Grid.Column="1" FontWeight="SemiBold" TextWrapping="Wrap" />
                    </Grid>
                    <Grid ColumnSpacing="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="135" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Дата подписания" Foreground="{StaticResource ShellSecondaryTextBrush}" />
                        <TextBlock x:Name="SignedAtText" Grid.Column="1" FontWeight="SemiBold" TextWrapping="Wrap" />
                    </Grid>
                </StackPanel>

                <StackPanel Grid.Column="1" Spacing="6">
                    <Grid ColumnSpacing="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="135" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Статус" Foreground="{StaticResource ShellSecondaryTextBrush}" />
                        <ContentControl
                            x:Name="ContractStatusHost"
                            Grid.Column="1"
                            HorizontalAlignment="Left" />
                    </Grid>
                    <Grid ColumnSpacing="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="135" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Дата закрытия" Foreground="{StaticResource ShellSecondaryTextBrush}" />
                        <TextBlock x:Name="ContractClosedAtText" Grid.Column="1" FontWeight="SemiBold" TextWrapping="Wrap" />
                    </Grid>
                    <Grid ColumnSpacing="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="135" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Стоимость" Foreground="{StaticResource ShellSecondaryTextBrush}" />
                        <TextBlock
                            x:Name="ContractCostText"
                            Grid.Column="1"
                            FontWeight="SemiBold"
                            Foreground="{StaticResource ShellAccentBrush}"
                            TextWrapping="Wrap" />
                    </Grid>
                    <Grid ColumnSpacing="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="135" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Особенности" Foreground="{StaticResource ShellSecondaryTextBrush}" />
                        <TextBlock x:Name="ContractKindText" Grid.Column="1" FontWeight="SemiBold" TextWrapping="Wrap" />
                    </Grid>
                </StackPanel>
            </Grid>

            <Grid HorizontalAlignment="Stretch" ColumnSpacing="6">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Button
                    x:Name="PreviousStageButton"
                    Grid.Column="1"
                    Width="24"
                    Height="24"
                    MinWidth="0"
                    MinHeight="0"
                    Padding="0"
                    BorderThickness="0"
                    CornerRadius="5"
                    FontFamily="Segoe Fluent Icons"
                    FontSize="12"
                    Content="&#xE76B;" />
                <TextBlock
                    x:Name="StageTitleText"
                    Grid.Column="2"
                    VerticalAlignment="Center"
                    FontSize="14"
                    LineHeight="18"
                    FontWeight="SemiBold"
                    Foreground="{StaticResource ShellPrimaryTextBrush}"
                    TextAlignment="Center"
                    TextTrimming="CharacterEllipsis"
                    TextWrapping="NoWrap" />
                <Button
                    x:Name="NextStageButton"
                    Grid.Column="3"
                    Width="24"
                    Height="24"
                    MinWidth="0"
                    MinHeight="0"
                    Padding="0"
                    BorderThickness="0"
                    CornerRadius="5"
                    FontFamily="Segoe Fluent Icons"
                    FontSize="12"
                    Content="&#xE76C;" />
            </Grid>

            <Grid ColumnSpacing="42" RowSpacing="6">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <StackPanel Spacing="6">
                    <Grid ColumnSpacing="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="135" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Дата начала" Foreground="{StaticResource ShellSecondaryTextBrush}" />
                        <TextBlock x:Name="StartAtText" Grid.Column="1" FontWeight="SemiBold" TextWrapping="Wrap" />
                    </Grid>
                    <Grid ColumnSpacing="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="135" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Предоплата" Foreground="{StaticResource ShellSecondaryTextBrush}" />
                        <TextBlock x:Name="PrepaymentText" Grid.Column="1" FontWeight="SemiBold" TextWrapping="Wrap" />
                    </Grid>
                </StackPanel>

                <StackPanel Grid.Column="1" Spacing="6">
                    <Grid ColumnSpacing="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="135" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Срок завершения" Foreground="{StaticResource ShellSecondaryTextBrush}" />
                        <TextBlock x:Name="DeadlineAtText" Grid.Column="1" FontWeight="SemiBold" TextWrapping="Wrap" />
                    </Grid>
                    <Grid ColumnSpacing="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="135" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Прочее" Foreground="{StaticResource ShellSecondaryTextBrush}" />
                        <TextBlock x:Name="TasksText" Grid.Column="1" FontWeight="SemiBold" TextWrapping="Wrap" />
                    </Grid>
                </StackPanel>
            </Grid>
        </StackPanel>

        <Border
            Grid.Row="1"
            BorderBrush="{StaticResource ShellTableGridLineBrush}"
            BorderThickness="0,1,0,0" />

        <Grid Grid.Row="2" RowSpacing="12">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Grid ColumnSpacing="14">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Border
                    Padding="10,8,10,10"
                    Background="#EFFFF2"
                    BorderBrush="{StaticResource ShellPanelBorderBrush}"
                    BorderThickness="1"
                    CornerRadius="6">
                    <StackPanel Spacing="8">
                        <TextBlock
                            Margin="4,0,4,0"
                            FontSize="11"
                            LineHeight="12"
                            FontWeight="SemiBold"
                            Foreground="{StaticResource ShellTableHeaderTextBrush}"
                            Text="Выполнение" />
                        <StackPanel Spacing="4">
                            <TextBlock FontSize="12" Text="Исполнители" />
                            <ContentControl
                                x:Name="PerformersHost"
                                HorizontalContentAlignment="Stretch" />
                        </StackPanel>
                        <Grid
                            ColumnSpacing="10"
                            VerticalAlignment="Center">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="160" />
                                <ColumnDefinition Width="116" />
                            </Grid.ColumnDefinitions>
                            <ContentControl
                                x:Name="RideOutCheckHost"
                                VerticalAlignment="Center" />
                            <ContentControl
                                x:Name="RideOutAtHost"
                                Grid.Column="1"
                                HorizontalContentAlignment="Stretch" />
                        </Grid>
                        <Grid ColumnSpacing="10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="160" />
                                <ColumnDefinition Width="116" />
                            </Grid.ColumnDefinitions>
                            <ContentControl
                                x:Name="SendedCheckHost"
                                VerticalAlignment="Center" />
                            <ContentControl
                                x:Name="SendedAtHost"
                                Grid.Column="1"
                                HorizontalContentAlignment="Stretch" />
                        </Grid>
                    </StackPanel>
                </Border>

                <Border
                    Grid.Column="1"
                    Padding="10,8,10,10"
                    Background="{StaticResource ShellMutedPanelBackgroundBrush}"
                    BorderBrush="{StaticResource ShellPanelBorderBrush}"
                    BorderThickness="1"
                    CornerRadius="6">
                    <StackPanel Spacing="8">
                        <TextBlock
                            Margin="4,0,4,0"
                            FontSize="11"
                            LineHeight="12"
                            FontWeight="SemiBold"
                            Foreground="{StaticResource ShellTableHeaderTextBrush}"
                            Text="Состояние" />
                        <StackPanel Spacing="4">
                            <TextBlock FontSize="12" Text="Статус этапа" />
                            <ContentControl
                                x:Name="StatusHost"
                                HorizontalContentAlignment="Stretch" />
                        </StackPanel>
                        <Grid ColumnSpacing="10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="116" />
                                <ColumnDefinition Width="116" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Spacing="4">
                                <TextBlock FontSize="12" Text="Работа выполнена" />
                                <ContentControl
                                    x:Name="CompletedAtHost"
                                    HorizontalAlignment="Left"
                                    HorizontalContentAlignment="Stretch" />
                            </StackPanel>
                            <StackPanel Grid.Column="1" Spacing="4">
                                <TextBlock FontSize="12" Text="Закрыт" />
                                <ContentControl
                                    x:Name="ClosedAtHost"
                                    HorizontalAlignment="Left"
                                    HorizontalContentAlignment="Stretch" />
                            </StackPanel>
                        </Grid>
                        <Grid ColumnSpacing="10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="120" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="70" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="80" />
                            </Grid.ColumnDefinitions>
                            <ContentControl
                                x:Name="RegistryCheckHost"
                                VerticalAlignment="Center" />
                            <TextBlock
                                Grid.Column="1"
                                Text="Квартал"
                                FontWeight="SemiBold"
                                VerticalAlignment="Center" />
                            <ContentControl
                                x:Name="RegistryQuarterHost"
                                Grid.Column="2"
                                HorizontalContentAlignment="Stretch"
                                VerticalAlignment="Center" />
                            <TextBlock
                                Grid.Column="3"
                                Text="Год"
                                FontWeight="SemiBold"
                                VerticalAlignment="Center" />
                            <ContentControl
                                x:Name="RegistryYearHost"
                                Grid.Column="4"
                                HorizontalContentAlignment="Stretch"
                                VerticalAlignment="Center" />
                        </Grid>
                    </StackPanel>
                </Border>
            </Grid>

            <StackPanel Grid.Row="1" Spacing="4">
                <TextBlock FontSize="12" Text="Комментарий" />
                <ContentControl
                    x:Name="CommentHost"
                    HorizontalContentAlignment="Stretch" />
            </StackPanel>

            <ContentControl
                x:Name="CommentListHost"
                Grid.Row="2"
                HorizontalContentAlignment="Stretch" />
        </Grid>
    </Grid>
</UserControl>
