<UserControl
    x:Class="CbsContractsDesktopClient.Views.Controls.TableExportControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <StackPanel Orientation="Horizontal" Spacing="4">
        <Button x:Name="ExportButton" Width="{StaticResource ShellActionButtonSize}"
            Height="{StaticResource ShellActionButtonSize}" Padding="0" Background="Transparent"
            BorderBrush="{x:Null}" FontFamily="{StaticResource SymbolThemeFontFamily}" FontSize="14"
            Foreground="{StaticResource ShellPrimaryTextBrush}" Content="&#xEDE1;"
            ToolTipService.ToolTip="Экспорт в Excel" Click="Export_Click" />
        <TextBlock x:Name="ProgressText" VerticalAlignment="Center" FontSize="11"
            Foreground="{StaticResource ShellSecondaryTextBrush}" Visibility="Collapsed" />
        <Button x:Name="CancelButton" Width="{StaticResource ShellActionButtonSize}"
            Height="{StaticResource ShellActionButtonSize}" Padding="0" Background="Transparent"
            BorderBrush="{x:Null}" FontFamily="{StaticResource SymbolThemeFontFamily}" FontSize="12"
            Content="&#xE711;" ToolTipService.ToolTip="Отменить экспорт" Visibility="Collapsed" Click="Cancel_Click" />
    </StackPanel>
</UserControl>
